--- a/diablo_interaction/diablo_ctrl/src/diablo_ctrl.cpp
+++ b/diablo_interaction/diablo_ctrl/src/diablo_ctrl.cpp
@@ -1,3 +1,4 @@
+#include <cmath>
 #include <iostream>
 #include "diablo_ctrl.hpp"
 
@@ -120,6 +121,32 @@
     diablo_body_state_publisher bodyStatePublisher(node,&vehicle);
     bodyStatePublisher.body_pub_init();
 
+    // Wait for valid telemetry before letting the movement worker acquire control.
+    using namespace DIABLO::OSDK;
+    auto *telemetry = vehicle.telemetry;
+    bool ready = false;
+    for (int attempt = 0; attempt < 3 && !ready; ++attempt) {
+        for (auto topic : {TOPIC_STATUS, TOPIC_QUATERNION, TOPIC_ACCL, TOPIC_GYRO,
+                           TOPIC_RC, TOPIC_POWER, TOPIC_MOTOR})
+            telemetry->configTopic(topic, OSDK_PUSH_DATA_50Hz);
+        if (telemetry->configUpdate(false)) break;
+        telemetry->eraseNewcomeFlag(0);
+        for (int poll = 0; poll < 20 && !ready; ++poll) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            std::lock_guard<std::mutex> rx(Hal.serial_rx_mtx);
+            std::lock_guard<std::mutex> flags(telemetry->newcome_mtx);
+            ready = (telemetry->newcome & 0x42) == 0x42 &&
+                    std::isfinite(telemetry->power.voltage) && telemetry->power.voltage > 0 &&
+                    telemetry->power.power_percent <= 100;
+        }
+    }
+    if (!ready) {
+        RCLCPP_ERROR(node->get_logger(), "No complete live battery/status sample; chassis not enabled");
+        return -1;
+    }
+    RCLCPP_INFO(node->get_logger(), "Complete telemetry confirmed before chassis startup");
+
+
