Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 360
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 70; 74; 80
      Alpha: 0.35
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved site cloud
      Enabled: true
      Topic:
        Value: /site_cloud
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Max Value: 2
      Min Value: 0
      Use Fixed Frame: true
      Alpha: 0.9
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: DIABLO (no brain / planner arm)
      Enabled: true
      Alpha: 0.35
      Description Source: Topic
      Description Topic:
        Value: /blind/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: blind
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: DIABLO (fly brain)
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Paths, objects, decoder state
      Enabled: true
      Topic:
        Value: /replay_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Follow robot
      Target Frame: base_link
      Distance: 6.5
      Pitch: 0.75
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Height: 900
  Width: 1600
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd000000010000000000000136000003a2fc0200000001fb000000100044006900730070006c0061007900730100000000000003a2000000c700ffffff000004640000036b00000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
