# Copy to configs/local.env (git-ignored) and `set -a; . configs/local.env; set +a` before the launchers.

# --- fly brain (GPU host) ---
FLYHEAD_UPSTREAM_DIR=third_party/fly-brain     # filled by scripts/fetch_upstream.py
FLYHEAD_CACHE_DIR=cache
FLYHEAD_BRAIN_PYTHON=.venv-brain/bin/python
XT_BRAIN_PORT=8095
LOOM_DECODER=9                                  # 1..9, see flyhead/fly/decoders/loom.py

# --- control server (compute host) ---
XT_ROBOT_HOST=robot                             # SSH alias of the robot (~/.ssh/config)
XT_ROBOT_ROOT=/home/<robot-user>/FlyHead        # absolute FlyHead checkout on the robot
XT_MAP=maps/<package>
XT_BRAIN_ENABLED=0                              # 1: brain modes selectable in the console
XT_CHASSIS_DISABLED=1                           # 1 = charging lock (no motion)
XT_REMOTE_MOTION_ENABLED=0                      # second opt-in for motion
XT_MAX_V=0.30                                   # m/s ceiling (never above 1.0)

# --- monitor (operator PC) ---
XT_COMPUTE_HOST=compute                         # SSH alias of the compute host
